#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

gitleaks_bin="$(git config --get dotfiles.gitleaks-path || true)"
if [[ -z "$gitleaks_bin" || ! -x "$gitleaks_bin" ]]; then
  echo "The pinned Gitleaks binary is unavailable; run 'just install-hooks'." >&2
  exit 1
fi

exec "$gitleaks_bin" --no-banner --redact git --pre-commit --staged .
